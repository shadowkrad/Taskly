// Prisma schema for Taskly (Taaaac Ecosystem)
// SQLite isolato per tenant

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("DA_FARE")   // DA_FARE | IN_CORSO | COMPLETATO
  priority    String    @default("MEDIA")     // BASSA | MEDIA | ALTA
  category    String    @default("Generale")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([priority])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#4f46e5")
  createdAt DateTime @default(now())
}

// Clienti del gestionale: uno per numero di telefono (nati dagli interventi, ora con punti, tessera e compleanno)
model Customer {
  id               String   @id @default(cuid())
  name             String
  phone            String
  email            String?
  address          String?
  notes            String?
  birthDate        DateTime? // facoltativa: serve per il buono compleanno
  marketingConsent Boolean  @default(false) // consenso a comunicazioni promozionali
  loyaltyPoints    Int      @default(0)
  loyaltyToken     String?  @unique // link privato della tessera fedelta' digitale
  pointsMovements  MovimentoPunti[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([phone])
}

// Fidelity: movimenti dei punti (i punti vivono nel database dell'attivita', insieme ai clienti)
model MovimentoPunti {
  id             String   @id @default(cuid())
  clienteId      String
  cliente        Customer @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  punti          Int
  tipo           String   @default("ACCREDITO") // ACCREDITO | RISCATTO
  origine        String? // SPESA | APPUNTAMENTO | BENVENUTO | MANUALE | PREMIO | STORNO
  descrizione    String?
  importo        Float?
  appuntamentoId String?
  premioId       String?
  saldoDopo      Int?
  operatore      String?
  createdAt      DateTime @default(now())

  @@index([clienteId])
  @@index([appuntamentoId])
}

// Buoni: regalo, sconto, compensazione, gesto commerciale, premio punti, compleanno, promozione
model GiftCard {
  id                    String              @id @default(cuid())
  codice                String              @unique
  importoIniziale       Float
  saldoResiduo          Float
  acquirenteNome        String
  acquirenteEmail       String?
  acquirenteTelefono    String?
  beneficiarioNome      String
  beneficiarioMessaggio String?
  dataScadenza          DateTime?
  stato                 String              @default("ATTIVA") // ATTIVA | RISCATTATA | SCADUTA | ANNULLATA
  motivo                String              @default("REGALO")
  tipoValore            String              @default("IMPORTO") // IMPORTO | PERCENTUALE | SERVIZIO
  percentuale           Float?
  descrizioneServizio   String?
  clienteId             String?
  spesaMinima           Float?
  usoParziale           Boolean             @default(true)
  note                  String?
  tokenPubblico         String?             @unique
  creatoDa              String?
  movimenti             MovimentoGiftCard[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([codice])
  @@index([stato])
  @@index([clienteId])
}

model MovimentoGiftCard {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  importo    Float
  tipo       String? // EMISSIONE | USO | ANNULLO | STAMPA | RISTAMPA | INVIO
  saldoDopo  Float?
  operatore  String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([giftCardId])
}

model ServiceRequest {
  id            String       @id @default(cuid())
  customerName  String
  phone         String
  email         String?
  address       String
  serviceType   String       // es. "Idraulica", "Elettrico", "Caldaie & Clima", "Serrature & Fabbro", "Pronto Intervento"
  description   String
  urgency       String       @default("ORDINARIO") // ORDINARIO | URGENTE | EMERGENZA
  status        String       @default("IN_ATTESA") // IN_ATTESA | PIANIFICATO | IN_CORSO | COMPLETATO | ANNULLATO
  preferredTime String?      // es. "Mattina (08:00 - 12:00)", "Pomeriggio (14:00 - 18:00)"
  scheduledAt   DateTime?
  estimatedCost Float?
  finalCost     Float?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workReports   WorkReport[]

  @@index([status])
  @@index([urgency])
}

model WorkReport {
  id                String         @id @default(cuid())
  serviceRequestId  String
  serviceRequest    ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  hoursWorked       Float          @default(1.0)
  hourlyRate        Float          @default(45.0)
  materialsUsed     String?        // Descrizione / lista dei ricambi e costi
  customerSignature String?        // Data URL firma o conferma cliente
  totalAmount       Float          @default(0.0)
  paymentStatus     String         @default("DA_PAGARE") // DA_PAGARE | SALDATO
  paymentMethod     String?        // CONTANTI | POS | BONIFICO
  technicianNotes   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([serviceRequestId])
}

// Modelli per Accesso Sicuro PWA & Dispositivi FIDO2 WebAuthn (v1.0.2)
model RegisteredDevice {
  id           String    @id @default(cuid())
  deviceName   String
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  transports   String?
  deviceType   String    @default("smartphone") // smartphone, tablet, desktop
  status       String    @default("ACTIVE")      // ACTIVE, REVOKED
  lastUsedAt   DateTime?
  registeredAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([credentialId])
  @@index([status])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  type      String   // "registration" | "authentication"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model TenantLocalCache {
  id           String   @id @default("singleton")
  brandName    String   @default("Taskly • Taaaac Suite")
  logoUrl      String?
  faviconUrl   String?
  primaryColor String   @default("#1e1b4b")
  accentColor  String   @default("#4f46e5")
  email        String?
  contactEmail String?
  phone        String?
  showcaseConfig String? @default("{}")
  telegramEnabled     Boolean   @default(false)
  telegramBotToken    String?
  telegramBotUsername String?
  telegramStaffChatId String?
  fidelityEnabled     Boolean   @default(false)
  fidelityRules       String?   @default("{}")
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  mfaBackupCodes      String?   // JSON array di codici crittografati
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(1)
  rispettaFestivitaNazionali Boolean @default(true)
  updatedAt    DateTime @updatedAt
}

model EccezioneCalendario {
  id             String   @id @default(cuid())
  data           String   @unique // YYYY-MM-DD
  titolo         String
  tipo           String   @default("CHIUSURA") // CHIUSURA | APERTURA_STRAORDINARIA | ORARIO_SPECIALE
  isAperto       Boolean  @default(false)
  orarioApertura String?
  orarioChiusura String?
  pausaInizio    String?
  pausaFine      String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}



model TrustedDevice {
  id          String    @id @default(cuid())
  deviceHash  String    @unique
  deviceName  String
  deviceType  String    @default("desktop")
  browser     String?
  os          String?
  ipAddress   String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
}

model AccessLog {
  id          String    @id @default(cuid())
  esito       String
  ipAddress   String
  userAgent   String?
  deviceType  String    @default("desktop")
  browser     String?
  os          String?
  mfaUsed     Boolean   @default(false)
  dettaglio   String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}
